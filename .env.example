NODE_ENV=development
PORT=3000

# Generate a long random value and keep it private.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Local HTTP / LAN access:
COOKIE_SECURE=false

# Set both to true/1 only when HTTPS is terminated by a trusted reverse proxy.
TRUST_PROXY=0

# Optional. Production paths must point to persistent storage.
# DATABASE_PATH=
# SESSION_DB_PATH=
